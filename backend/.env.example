# Server Configuration
PORT=4000
NODE_ENV=development

# Database Configuration
DATABASE_URL="postgresql://user:password@localhost:5432/future_isa?schema=public"

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your-refresh-token-secret
JWT_REFRESH_EXPIRES_IN=30d

# CORS Configuration
CORS_ORIGIN=http://localhost:3000,http://localhost:3001

# Email Configuration (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
EMAIL_FROM=noreply@future-isa.or.kr

# File Upload Configuration
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=20971520
ALLOWED_FILE_TYPES=.pdf,.docx,.doc

# Payment Gateway (Toss Payments)
TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=
TOSS_SUCCESS_URL=http://localhost:3000/payment/success
TOSS_FAIL_URL=http://localhost:3000/payment/fail

# KCI API (Korean Citation Index)
KCI_API_KEY=
KCI_API_URL=

# Frontend URLs
FRONTEND_URL=http://localhost:3000
SUBMISSION_URL=http://localhost:3001

# Admin Configuration
ADMIN_EMAIL=admin@future-isa.or.kr
ADMIN_PASSWORD=change-this-password
